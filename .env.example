# Copy this file to .env and fill in your real values.

# Local Postgres example (run `whoami` for your Mac username):
DATABASE_URL=postgresql://your_mac_username@localhost:5432/drishti

# REQUIRED for real use. Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a temporary one is used and everybody is logged out whenever the
# server restarts. Never share it or commit it to git.
JWT_SECRET=

# Optional: bcrypt work factor (default 12). Leave alone.
# BCRYPT_ROUNDS=12
